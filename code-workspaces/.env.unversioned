## This is for dual-used scenario: .env -> .env.unversioned.
## For split case, see https://github.com/verdimrc/linuxcfg/tree/main/vscode

# NOTE on my setup: the .env or .env.unversioned are dual-used by shell and IDE.
# - when sourced by zsh: has var expansion; export as env vars to propagate to subprocesses
# - when used by vscode: no var expansion
#
# My .zshrc auto-sources $GITROOT/.env.unversioned (only under vscode), hence the
# export stanzas. In addition, env var works.
#
# When used by vscode IDE, .env injects PYTHONPATH to allow static analysis to recognize
# additional Python modules. Unfortunately, under this scenario, env vars are not resolved,
# hence the hardcoded path.
#
# Sometime, .env symlinks to .env.unversioned for dual-used by zsh and IDE. Hence, PYTHONPATH
# hardcodes the repos under the workspace (for IDE), but mix-in env vars (effective when
# sourced by IDE).
PYTHONPATH=/home/vmarch/src/Megatron-Bridge/src:/home/vmarch/src/Megatron-LM:/home/vmarch/src/TransformerEngine:$PYTHONPATH

# [20260515] Not sure if this is still needed (ref: https:#github.com/verdimrc/linuxcfg/blob/cf7f7b98e5835b2356b5d463bcb03926844df794/vscode/.env#L14-L15)
PATH=~/.local/bin/:$PATH
